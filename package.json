{
  "name": "orus-erp-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "npm run build && nodemon --watch src --ext ts,json --exec \"npm run build &&   node dist/index.js\"",
    "build": "tsc",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "prestart": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "vitest run src",
    "test:watch": "vitest src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Orus ERP Backend API",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
