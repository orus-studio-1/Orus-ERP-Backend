  @@unique([companyId, name])
  @@index([companyId])
}

model SalaryStructure {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  name        String
  description String?
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
