generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================== AUTH =====================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  avatar    String?
  role      UserRole @default(EMPLOYEE)
  companyId String?
  company   Company? @relation("CompanyUsers", fields: [companyId], references: [id])
  ownedCompanies Company[] @relation("CompanyOwner")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee      Employee?
  accessRoles   UserAccessRole[]
  permissionOverrides UserPermissionOverride[]
  accessAuditLogs AccessAuditLog[] @relation("AccessAuditActor")
  createdLeads  Lead[]         @relation("LeadCreatedBy")
  assignedLeads Lead[]         @relation("LeadAssignedTo")
  activities    Activity[]
  tasks         Task[]         @relation("TaskAssignee")
  createdTasks  Task[]         @relation("TaskCreator")
  comments      Comment[]
  notifications Notification[]
  crmOrganizations CrmOrganization[] @relation("CrmOrganizationOwner")
  leadImportBatches LeadImportBatch[] @relation("LeadImportBy")
  crmSavedViews CrmSavedView[]
  crmAssignmentRules CrmAssignmentRule[] @relation("CrmAssignmentRuleAssignee")
  createdSalesInvoices SalesInvoice[] @relation("SalesInvoiceCreatedBy")
  assignedSalesInvoices SalesInvoice[] @relation("SalesInvoiceAssignedTo")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  ACCOUNTANT
  HR_MANAGER
  HR_OFFICER
  PAYROLL_OFFICER
  SALES_REP
  PURCHASE_MANAGER
}

// ===================== COMPANY =====================
model Company {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  zip       String?
  taxId     String?
  currency  String   @default("USD")
  logo      String?
  website   String?
  ownerId   String?
  owner     User?    @relation("CompanyOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]   @relation("CompanyUsers")
  accessRoles AccessRole[]
  permissionOverrides UserPermissionOverride[]
  accessAuditLogs AccessAuditLog[]
  crmOrganizations CrmOrganization[]
  leadImportBatches LeadImportBatch[]
  crmSavedViews CrmSavedView[]
  crmAssignmentRules CrmAssignmentRule[]
}

enum PermissionAction {
  READ
  CREATE
  WRITE
  DELETE
  SUBMIT
  CANCEL
  AMEND
  APPROVE
  EXPORT
  IMPORT
  PRINT
  REPORT
  MANAGE
}

enum AccessEffect {
  ALLOW
  DENY
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  resource    String
  action      PermissionAction
  label       String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@unique([module, resource, action])
  @@index([module, action])
}

model AccessRole {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  name        String
  title       String?
  description String?
  isSystem    Boolean  @default(false)
  isSuperAdmin Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserAccessRole[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model UserAccessRole {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedAt DateTime   @default(now())

  @@unique([userId, roleId])
  @@index([userId])
}

model RolePermission {
  id           String       @id @default(cuid())
  roleId       String
  role         AccessRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       AccessEffect @default(ALLOW)
  conditions   Json?
  createdAt    DateTime     @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId, effect])
}

model UserPermissionOverride {
  id           String       @id @default(cuid())
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       AccessEffect
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())

  @@unique([userId, permissionId])
  @@index([companyId, userId, effect])
}

model AccessAuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  actorId     String?
  actor       User?    @relation("AccessAuditActor", fields: [actorId], references: [id])
  targetUserId String?
  targetRoleId String?
  action      String
  message     String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetRoleId, createdAt])
}

// ===================== ACCOUNTING =====================
model Account {
  id          String      @id @default(cuid())
  companyId   String?
  code        String      @unique
  name        String
  type        AccountType
  subType     String?
  parentId    String?
  parent      Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[]   @relation("AccountHierarchy")
  description String?
  rootType    AccountType?
  isGroup     Boolean     @default(false)
  freezeAccount Boolean   @default(false)
  frozenTillDate DateTime?
  isDefaultCash Boolean   @default(false)
  isDefaultBank Boolean   @default(false)
  isDefaultReceivable Boolean @default(false)
  isDefaultPayable Boolean @default(false)
  isDefaultTax Boolean    @default(false)
  isDefaultRoundOff Boolean @default(false)
  isDefaultRetainedEarnings Boolean @default(false)
  isActive    Boolean     @default(true)
  balance     Decimal     @default(0) @db.Decimal(18, 6)
  currency    String      @default("USD")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  debitLines        JournalLine[]        @relation("DebitAccount")
  creditLines       JournalLine[]        @relation("CreditAccount")
  taxTemplateLines  TaxTemplateLine[]
  salesInvoiceTaxes SalesInvoiceTax[]
  creditNoteTaxes   CreditNoteTax[]
  ledgerEntries     GeneralLedgerEntry[]
  budgets           Budget[]
  bankStatementLines BankStatementLine[]
  retainedEarningsClosings PeriodClosingVoucher[]
  fixedAssets       FixedAsset[] @relation("AssetAccount")

  @@index([companyId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model FiscalYear {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())

  periods         Period[]
  numberingSeries NumberingSeries[]

  @@index([companyId])
}

model Period {
  id           String     @id @default(cuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])
  isClosed     Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model JournalEntry {
  id          String      @id @default(cuid())
  companyId   String?
  entryNumber String      @unique
  date        DateTime
  description String
  reference   String?
  referenceType String?
  referenceId String?
  entryType   JournalEntryType @default(STANDARD)
  fiscalYearId String?
  periodId    String?
  status      EntryStatus @default(DRAFT)
  totalDebit  Decimal     @default(0) @db.Decimal(18, 6)
  totalCredit Decimal     @default(0) @db.Decimal(18, 6)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lines JournalLine[]

  @@index([companyId])
}

enum JournalEntryType {
  STANDARD
  OPENING
  CLOSING
  RECURRING
  EXCHANGE_REVALUATION
  DEPRECIATION
}

enum EntryStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  CANCELLED
}

enum DocumentType {
  QUOTATION
  SALES_ORDER
  DELIVERY_NOTE
  SALES_INVOICE
  PAYMENT_ENTRY
  CREDIT_NOTE
  STOCK_ENTRY
  PURCHASE_ORDER
  PURCHASE_INVOICE
  MATERIAL_REQUEST
  REQUEST_FOR_QUOTATION
  SUPPLIER_QUOTATION
  PURCHASE_RECEIPT
  LANDED_COST_VOUCHER
  BLANKET_PURCHASE_ORDER
  QUALITY_INSPECTION
  BUYING_SETTINGS
  EMPLOYEE
  ATTENDANCE
  LEAVE_APPLICATION
  PAYROLL_ENTRY
  SALARY_SLIP
  EMPLOYEE_LIFECYCLE
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CREDITED
}

enum NumberingResetPeriod {
  NEVER
  FISCAL_YEAR
  MONTHLY
}

enum TaxChargeType {
  ON_NET_TOTAL
  ON_PREVIOUS_ROW_AMOUNT
  ON_PREVIOUS_ROW_TOTAL
}

enum TaxTemplateScope {
  ITEM
  INVOICE
  BOTH
}

enum PaymentEntryStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum PaymentAllocationType {
  INVOICE
  ADVANCE
  CREDIT_NOTE
}

enum LedgerVoucherType {
  JOURNAL_ENTRY
  SALES_INVOICE
  PURCHASE_INVOICE
  PURCHASE_RECEIPT
  SUPPLIER_PAYMENT
  LANDED_COST_VOUCHER
  PAYMENT_ENTRY
  CREDIT_NOTE
  STOCK_ENTRY
  PERIOD_CLOSING
  EXCHANGE_REVALUATION
  ASSET_DEPRECIATION
  CANCELLATION
}

enum CreditNoteReason {
  SALES_RETURN
  RATE_ADJUSTMENT
  DISCOUNT
  TAX_CORRECTION
  FULL_REVERSAL
  OTHER
}

enum RecurrenceFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum PrintFormatDocType {
  SALES_INVOICE
  CREDIT_NOTE
  PAYMENT_ENTRY
}

enum LifecycleEventType {
  ONBOARDING
  PROMOTION
  TRANSFER
  SEPARATION
}

enum LifecycleEventStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum CheckinType {
  IN
  OUT
}

enum ShiftAssignmentStatus {
  ACTIVE
  INACTIVE
}

enum LeaveLedgerEntryType {
  ALLOCATION
  APPLICATION
  ENCASHMENT
  EXPIRY
  ADJUSTMENT
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
  TAX
  BENEFIT
}

enum PayrollEntryStatus {
  DRAFT
  SUBMITTED
  PAID
  CANCELLED
}

enum SalarySlipStatus {
  DRAFT
  SUBMITTED
  PAID
  CANCELLED
}

model JournalLine {
  id              String       @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  debitAccountId  String?
  debitAccount    Account?     @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccountId String?
  creditAccount   Account?     @relation("CreditAccount", fields: [creditAccountId], references: [id])
  debit           Decimal      @default(0) @db.Decimal(18, 6)
  credit          Decimal      @default(0) @db.Decimal(18, 6)
  currency        String       @default("USD")
  exchangeRate    Decimal      @default(1) @db.Decimal(18, 6)
  costCenterId    String?
  costCenter      CostCenter?  @relation(fields: [costCenterId], references: [id])
  description     String?
  createdAt       DateTime     @default(now())
}

model CostCenter {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  parentId    String?
  parent      CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id])
  children    CostCenter[] @relation("CostCenterTree")
  isGroup     Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  journalLines  JournalLine[]
  ledgerEntries GeneralLedgerEntry[]
  budgets       Budget[]
  materialRequests MaterialRequest[]
  purchaseOrders PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  purchaseInvoices PurchaseInvoice[]

  @@index([parentId])
}

model NumberingSeries {
  id           String               @id @default(cuid())
  companyId    String?
  documentType DocumentType
  name         String
  pattern      String
  prefix       String?
  current      Int                  @default(0)
  digits       Int                  @default(5)
  resetPeriod  NumberingResetPeriod @default(FISCAL_YEAR)
  fiscalYearId String?
  fiscalYear   FiscalYear?          @relation(fields: [fiscalYearId], references: [id])
  branch       String?
  isDefault    Boolean              @default(false)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([documentType, name, fiscalYearId, branch])
  @@index([companyId])
  @@index([documentType, isDefault, isActive])
}

// ===================== INVENTORY =====================
model Category {
  id          String     @id @default(cuid())
  companyId   String?
  name        String
  code        String?    @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]

  @@index([companyId])
}

model Unit {
  id        String   @id @default(cuid())
  companyId String?
  name      String   @unique
  symbol    String
  createdAt DateTime @default(now())

  products          Product[]
  salesInvoiceItems SalesInvoiceItem[]
  subscriptionItems SubscriptionTemplateItem[]

  @@index([companyId])
}

model Product {
  id                   String       @id @default(cuid())
  companyId            String?
  sku                  String       @unique
  name                 String
  description          String?
  categoryId           String?
  category             Category?    @relation(fields: [categoryId], references: [id])
  unitId               String?
  unit                 Unit?        @relation(fields: [unitId], references: [id])
  type                 ProductType  @default(PRODUCT)
  costPrice            Decimal      @default(0) @db.Decimal(18, 6)
  salePrice            Decimal      @default(0) @db.Decimal(18, 6)
  taxRate              Decimal      @default(0) @db.Decimal(9, 4)
  minStockLevel        Decimal      @default(0) @db.Decimal(18, 6)
  maxStockLevel        Decimal?     @db.Decimal(18, 6)
  valuationMethod      ValuationMethod @default(MOVING_AVERAGE)
  maintainStock        Boolean      @default(true)
  allowNegativeStock   Boolean      @default(false)
  hasBatchNo           Boolean      @default(false)
  hasSerialNo          Boolean      @default(false)
  reorderLevel         Decimal      @default(0) @db.Decimal(18, 6)
  reorderQty           Decimal      @default(0) @db.Decimal(18, 6)
  brand                String?
  manufacturer         String?
  isActive             Boolean      @default(true)
  image                String?
  barcode              String?
  weight               Decimal?     @db.Decimal(18, 6)
  hsnCode              String?
  taxCode              String?
  defaultTaxTemplateId String?
  defaultTaxTemplate   TaxTemplate? @relation("ProductDefaultTaxTemplate", fields: [defaultTaxTemplateId], references: [id])
  defaultWarehouseId   String?
  isVariant            Boolean      @default(false)
  variantOfId          String?
  variantOf            Product?     @relation("ProductVariants", fields: [variantOfId], references: [id])
  variants             Product[]    @relation("ProductVariants")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  stockLevels          StockLevel[]
  movements            StockMovement[]
  deliveryNoteItems    DeliveryNoteItem[]
  salesOrderItems      SalesOrderItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  materialRequestItems MaterialRequestItem[]
  rfqItems             RequestForQuotationItem[]
  supplierQuotationItems SupplierQuotationItem[]
  blanketPurchaseOrderItems BlanketPurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  quotationItems       QuotationItem[]
  creditNoteItems      CreditNoteItem[]
  subscriptionItems    SubscriptionTemplateItem[]
  opportunityItems     OpportunityItem[]
  stockLedgerEntries   StockLedgerEntry[]
  valuationLayers      InventoryValuationLayer[]
  stockReservations    StockReservation[]
  stockEntryItems      StockEntryItem[]
  qualityInspections   QualityInspection[]
  batches              Batch[]
  serialNumbers        SerialNumber[]
  itemPrices           ItemPrice[]
  supplierItems        SupplierItem[]
  uomConversions       ProductUomConversion[]
  attributeValues      ProductAttributeValue[]

  @@index([variantOfId])
  @@index([defaultWarehouseId])
  @@index([companyId])
}

enum ProductType {
  PRODUCT
  SERVICE
  DIGITAL
}

enum ValuationMethod {
  FIFO
  MOVING_AVERAGE
  STANDARD
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  parentId  String?
  parent    Warehouse? @relation("WarehouseTree", fields: [parentId], references: [id])
  children  Warehouse[] @relation("WarehouseTree")
  type      WarehouseType @default(WAREHOUSE)
  companyId String?
  address   String?
  city      String?
  country   String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels StockLevel[]
  movements   StockMovement[]
  deliveryNotes DeliveryNote[]
  stockLedgerEntries StockLedgerEntry[]
  valuationLayers InventoryValuationLayer[]
  stockReservations StockReservation[]
  stockEntriesFrom StockEntry[] @relation("StockEntryFromWarehouse")
  stockEntriesTo StockEntry[] @relation("StockEntryToWarehouse")
  stockEntryItems StockEntryItem[]
  materialRequestItems MaterialRequestItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  batches Batch[]
  serialNumbers SerialNumber[]

  @@index([parentId])
  @@index([companyId])
}

enum WarehouseType {
  COMPANY
  BRANCH
  ROOM
  BIN
  WAREHOUSE
}

model StockLevel {
  id          String    @id @default(cuid())
  companyId   String?
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Float     @default(0)
  reservedQty Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([companyId])
}

model StockMovement {
  id          String       @id @default(cuid())
  companyId   String?
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  type        MovementType
  quantity    Float
  unitCost    Float?
  reference   String?
  notes       String?
  createdAt   DateTime     @default(now())

  @@index([companyId])
}

model StockLedgerEntry {
  id                   String    @id @default(cuid())
  companyId             String?
  productId             String
  product               Product   @relation(fields: [productId], references: [id])
  warehouseId           String
  warehouse             Warehouse @relation(fields: [warehouseId], references: [id])
  postingDate           DateTime  @default(now())
  voucherType           String
  voucherId             String?
  voucherNo             String
  actualQty             Decimal   @db.Decimal(18, 6)
  qtyAfterTransaction   Decimal   @db.Decimal(18, 6)
  incomingRate          Decimal?  @db.Decimal(18, 6)
  outgoingRate          Decimal?  @db.Decimal(18, 6)
  valuationRate         Decimal   @default(0) @db.Decimal(18, 6)
  stockValue            Decimal   @default(0) @db.Decimal(18, 6)
  stockValueDifference  Decimal   @default(0) @db.Decimal(18, 6)
  batchId               String?
  batch                 Batch?    @relation(fields: [batchId], references: [id])
  serialNoId            String?
  serialNo              SerialNumber? @relation(fields: [serialNoId], references: [id])
  isCancelled           Boolean   @default(false)
  remarks               String?
  createdAt             DateTime  @default(now())

  @@index([productId, warehouseId, postingDate])
  @@index([voucherType, voucherId])
  @@index([batchId])
  @@index([serialNoId])
  @@index([companyId])
}

model InventoryValuationLayer {
  id                    String    @id @default(cuid())
  companyId              String?
  productId              String
  product                Product   @relation(fields: [productId], references: [id])
  warehouseId            String
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id])
  sourceLedgerEntryId    String?
  postingDate            DateTime  @default(now())
  originalQty            Decimal   @db.Decimal(18, 6)
  remainingQty           Decimal   @db.Decimal(18, 6)
  rate                   Decimal   @db.Decimal(18, 6)
  isClosed               Boolean   @default(false)
  createdAt              DateTime  @default(now())

  @@index([productId, warehouseId, isClosed, postingDate])
  @@index([companyId])
}

model StockReservation {
  id               String                 @id @default(cuid())
  companyId         String?
  productId         String
  product           Product                @relation(fields: [productId], references: [id])
  warehouseId       String
  warehouse         Warehouse              @relation(fields: [warehouseId], references: [id])
  salesOrderId      String
  salesOrder        SalesOrder             @relation(fields: [salesOrderId], references: [id])
  salesOrderItemId  String
  salesOrderItem    SalesOrderItem         @relation(fields: [salesOrderItemId], references: [id])
  reservedQty       Decimal                @db.Decimal(18, 6)
  fulfilledQty      Decimal                @default(0) @db.Decimal(18, 6)
  status            StockReservationStatus @default(ACTIVE)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([productId, warehouseId, status])
  @@index([salesOrderId])
  @@index([salesOrderItemId])
  @@index([companyId])
}

enum StockReservationStatus {
  ACTIVE
  PARTIAL
  FULFILLED
  RELEASED
}

model StockEntry {
  id                String            @id @default(cuid())
  companyId         String?
  entryNo           String            @unique
  purpose           StockEntryPurpose
  status            DocumentStatus    @default(DRAFT)
  postingDate       DateTime          @default(now())
  fromWarehouseId   String?
  fromWarehouse     Warehouse?        @relation("StockEntryFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId     String?
  toWarehouse       Warehouse?        @relation("StockEntryToWarehouse", fields: [toWarehouseId], references: [id])
  remarks           String?
  submittedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items StockEntryItem[]

  @@index([status, purpose])
  @@index([postingDate])
  @@index([companyId])
}

model StockEntryItem {
  id                String      @id @default(cuid())
  stockEntryId      String
  stockEntry        StockEntry  @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  productId         String
  product           Product     @relation(fields: [productId], references: [id])
  warehouseId       String?
  warehouse         Warehouse?  @relation(fields: [warehouseId], references: [id])
  quantity          Decimal     @db.Decimal(18, 6)
  valuationRate     Decimal     @default(0) @db.Decimal(18, 6)
  batchId           String?
  serialNoId        String?
  remarks           String?
  createdAt         DateTime    @default(now())

  @@index([stockEntryId])
  @@index([productId])
}

enum StockEntryPurpose {
  MATERIAL_RECEIPT
  MATERIAL_ISSUE
  MATERIAL_TRANSFER
  STOCK_RECONCILIATION
  OPENING_STOCK
  REPACK
}

model Batch {
  id             String    @id @default(cuid())
  companyId      String?
  batchNo        String    @unique
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  warehouseId    String?
  warehouse      Warehouse? @relation(fields: [warehouseId], references: [id])
  expiryDate     DateTime?
  manufacturingDate DateTime?
  quantity       Decimal   @default(0) @db.Decimal(18, 6)
