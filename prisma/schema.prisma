  effectiveDate        DateTime
  previousDepartmentId String?
  newDepartmentId      String?
  previousPositionId   String?
  newPositionId        String?
  previousSalary       Decimal?             @db.Decimal(18, 6)
  newSalary            Decimal?             @db.Decimal(18, 6)
  reason               String?
  notes                String?
  submittedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([employeeId, type, status])
}

// ===================== CRM =====================
model CrmOrganization {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  name      String
  industry  String?
  website   String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  zip       String?
  ownerId   String?
  owner     User?    @relation("CrmOrganizationOwner", fields: [ownerId], references: [id])
  territory String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads         Lead[]
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  phones        CrmPhone[]

  @@index([companyId, name])
  @@index([ownerId])
}

model Lead {
  id              String           @id @default(cuid())
  companyId       String?
  title           String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  normalizedEmail String?
  normalizedPhone String?
  company         String?
  jobTitle        String?
  city            String?
  country         String?
  organizationId  String?
  organization    CrmOrganization? @relation(fields: [organizationId], references: [id])
  source          LeadSource       @default(OTHER)
  status          LeadStatus       @default(LEAD)
  priority        Priority         @default(MEDIUM)
  value           Float?
  score           Int              @default(0)
  tags            String[]         @default([])
  lostReason      String?
  lostReasonId    String?
  branchId        String?          @db.Uuid
  territory       String?
  productInterest String?
  campaign        String?
  mergedIntoId    String?
  notes           String?
  createdById     String
  createdBy       User             @relation("LeadCreatedBy", fields: [createdById], references: [id])
  assignedToId    String?
  assignedTo      User?            @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  importBatchId   String?
  importBatch     LeadImportBatch? @relation(fields: [importBatchId], references: [id])
  importRowNo     Int?
  lastContactedAt DateTime?
  qualifiedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  activities  Activity[]
  contacts    Contact[]
  opportunity Opportunity?
  phones      CrmPhone[]

  @@index([status, source])
  @@index([assignedToId, status])
  @@index([email])
  @@index([phone])
  @@index([organizationId])
  @@index([importBatchId])
  @@index([companyId])
  @@index([companyId, normalizedEmail])
  @@index([companyId, normalizedPhone])
  @@index([branchId, assignedToId])
}

model CrmAssignmentRule {
  id         String      @id @default(cuid())
  companyId  String?
  company    Company?    @relation(fields: [companyId], references: [id])
  name       String
  isActive   Boolean     @default(true)
  priority   Int         @default(100)
  source     LeadSource?
  city       String?
  country    String?
  territory  String?
  productId  String?
  branchId   String?     @db.Uuid
  minValue   Float?
  maxValue   Float?
  assignToId String
  assignTo   User        @relation("CrmAssignmentRuleAssignee", fields: [assignToId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([companyId, isActive, priority])
  @@index([assignToId])
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  EMAIL
  PHONE
  ADVERTISEMENT
  CSV_IMPORT
  INDIA_MART
  FACEBOOK_LEAD_ADS
  WHATSAPP
  OTHER
}

enum LeadStatus {
  LEAD
  OPEN
  REPLIED
  OPPORTUNITY
  QUOTATION
  LOST_QUOTATION
  INTERESTED
  CONVERTED
  DO_NOT_CONTACT
  UNQUALIFIED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model LeadImportBatch {
  id            String           @id @default(cuid())
  companyId     String?
  company       Company?         @relation(fields: [companyId], references: [id])
  fileName      String
  status        LeadImportStatus @default(PENDING)
  totalRows     Int              @default(0)
  createdRows   Int              @default(0)
  skippedRows   Int              @default(0)
  failedRows    Int              @default(0)
  duplicateRows Int              @default(0)
  importedById  String
  importedBy    User             @relation("LeadImportBy", fields: [importedById], references: [id])
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  errorSummary  String?
  createdAt     DateTime         @default(now())

  rows  LeadImportRow[]
  leads Lead[]

  @@index([companyId, createdAt])
  @@index([importedById, createdAt])
}

enum LeadImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model LeadImportRow {
  id              String              @id @default(cuid())
  batchId         String
  batch           LeadImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNo           Int
  status          LeadImportRowStatus
  rawData         Json
  normalizedData  Json?
  leadId          String?
  error           String?
  duplicateLeadId String?
  createdAt       DateTime            @default(now())

  @@unique([batchId, rowNo])
  @@index([batchId, status])
}

enum LeadImportRowStatus {
  CREATED
  SKIPPED
  FAILED
  DUPLICATE
}

model Contact {
  id             String           @id @default(cuid())
  companyId      String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  mobile         String?
  company        String?
  leadId         String?
  lead           Lead?            @relation(fields: [leadId], references: [id])
  organizationId String?
  organization   CrmOrganization? @relation(fields: [organizationId], references: [id])
  position       String?
  address        String?
  city           String?
  country        String?
  notes          String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  activities    Activity[]
  opportunities Opportunity[]
  customers     Customer[]
  phones        CrmPhone[]

  @@index([email])
  @@index([phone])
  @@index([leadId])
  @@index([organizationId])
  @@index([companyId])
}

model Opportunity {
  id               String           @id @default(cuid())
  companyId        String?
  branchId         String?          @db.Uuid
  title            String
  leadId           String?          @unique
  lead             Lead?            @relation(fields: [leadId], references: [id])
  contactId        String?
  contact          Contact?         @relation(fields: [contactId], references: [id])
  organizationId   String?
  organization     CrmOrganization? @relation(fields: [organizationId], references: [id])
  customerId       String?
  customer         Customer?        @relation(fields: [customerId], references: [id])
  quotationId      String?
  quotation        Quotation?       @relation("OpportunityQuotation", fields: [quotationId], references: [id])
  salesOrderId     String?
  salesOrder       SalesOrder?      @relation("OpportunitySalesOrder", fields: [salesOrderId], references: [id])
  value            Float
  currency         String           @default("USD")
  stage            OpportunityStage @default(PROSPECTING)
  probability      Int              @default(0)
  expectedClose    DateTime?
  forecastCategory String           @default("PIPELINE")
  competitor       String?
  ownerId          String?
  lostReasonId     String?
  lostReason       String?
  erpSyncStatus    CrmSyncStatus    @default(NOT_SYNCED)
  erpSyncError     String?
  wonAt            DateTime?
  lostAt           DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  activities Activity[]
  items      OpportunityItem[]

  @@index([stage, expectedClose])
  @@index([organizationId])
  @@index([customerId])
  @@index([quotationId])
  @@index([salesOrderId])
  @@index([companyId])
  @@index([branchId, ownerId])
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum CrmSyncStatus {
  NOT_SYNCED
  QUEUED
  SYNCED
  FAILED
}

model OpportunityItem {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  itemCode      String?
  description   String
  quantity      Decimal     @default(1) @db.Decimal(18, 6)
  rate          Decimal     @default(0) @db.Decimal(18, 6)
  discount      Decimal     @default(0) @db.Decimal(9, 4)
  taxRate       Decimal     @default(0) @db.Decimal(9, 4)
  amount        Decimal     @default(0) @db.Decimal(18, 6)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([opportunityId])
  @@index([productId])
}

model Activity {
  id               String           @id @default(cuid())
  companyId        String?
  branchId         String?          @db.Uuid
  type             ActivityType
  subject          String
  description      String?
  dueDate          DateTime?
  completedAt      DateTime?
  status           ActivityStatus   @default(PLANNED)
  metadata         Json?
  outcome          String?
  reminderAt       DateTime?
  reminderSentAt   DateTime?
  recurrenceRule   String?
  recurrenceEnd    DateTime?
  parentActivityId String?
  organizationId   String?
  organization     CrmOrganization? @relation(fields: [organizationId], references: [id])
  leadId           String?
  lead             Lead?            @relation(fields: [leadId], references: [id])
  contactId        String?
  contact          Contact?         @relation(fields: [contactId], references: [id])
  opportunityId    String?
  opportunity      Opportunity?     @relation(fields: [opportunityId], references: [id])
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([userId, status, dueDate])
  @@index([companyId])
  @@index([branchId, userId])
  @@index([reminderAt, reminderSentAt])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  FOLLOW_UP
  STATUS_CHANGE
  IMPORT
  CONVERSION
}

enum ActivityStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CrmSavedView {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  entity    String
  filters   Json
  columns   Json?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, entity, name])
  @@index([companyId, entity])
}

enum CrmScopeLevel {
  OWN
  TEAM
  BRANCH
  ALL
}

enum CrmCommunicationChannel {
  EMAIL
  WHATSAPP
  SMS
  SYSTEM
}

enum CrmCommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CrmDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model CrmScopeRule {
  id        String        @id @default(cuid())
  companyId String
  userId    String
  entity    String        @default("LEAD")
  scope     CrmScopeLevel @default(OWN)
  branchId  String?       @db.Uuid
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([companyId, userId, entity])
  @@index([companyId, entity, isActive])
}

model CrmLostReason {
  id        String   @id @default(cuid())
  companyId String
  name      String
  category  String?
  appliesTo String   @default("BOTH")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name, appliesTo])
  @@index([companyId, isActive, sortOrder])
}

// Managed territory list (Lead, Organization, Customer and assignment rules store the territory name).
model CrmTerritory {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, isActive, sortOrder])
}

// Several phone numbers per lead, contact or organization. `number` is what the user typed,
// `normalized` is digits only (used for duplicate checks). One number is primary; it is mirrored
// on Lead.phone / Contact.phone / CrmOrganization.phone so the single-phone code keeps working.
model CrmPhone {
  id             String           @id @default(cuid())
  companyId      String?
  leadId         String?
  lead           Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   CrmOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  normalized     String
  type           String           @default("MOBILE")
  isPrimary      Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([companyId, normalized])
  @@index([leadId])
  @@index([contactId])
  @@index([organizationId])
}

model CrmLeadEvent {
  id         String   @id @default(cuid())
  companyId  String?
  leadId     String
  type       String
  actorId    String?
  subject    String
  data       Json?
  occurredAt DateTime @default(now())

  @@index([leadId, occurredAt])
  @@index([companyId, type, occurredAt])
}

model OpportunityStageHistory {
  id            String            @id @default(cuid())
  companyId     String?
  opportunityId String
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  probability   Int
  changedById   String
