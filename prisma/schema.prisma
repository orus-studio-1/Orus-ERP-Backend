model SalarySlipItem {
  id                String           @id @default(cuid())
  salarySlipId      String
  salarySlip        SalarySlip       @relation(fields: [salarySlipId], references: [id], onDelete: Cascade)
  salaryComponentId String?
  salaryComponent   SalaryComponent? @relation(fields: [salaryComponentId], references: [id])
  type              SalaryComponentType
  name              String
  amount            Decimal          @default(0) @db.Decimal(18, 6)
  idx               Int              @default(0)
}

model EmployeeLifecycleEvent {
  id                  String               @id @default(cuid())
  employeeId          String
  employee            Employee             @relation(fields: [employeeId], references: [id])
  type                LifecycleEventType
  status              LifecycleEventStatus @default(DRAFT)
  effectiveDate       DateTime
  previousDepartmentId String?
  newDepartmentId     String?
  previousPositionId  String?
  newPositionId       String?
  previousSalary      Decimal?             @db.Decimal(18, 6)
  newSalary           Decimal?             @db.Decimal(18, 6)
  reason              String?
  notes               String?
  submittedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([employeeId, type, status])
}

// ===================== CRM =====================
model CrmOrganization {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  name        String
  industry    String?
  website     String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  zip         String?
  ownerId     String?
  owner       User?    @relation("CrmOrganizationOwner", fields: [ownerId], references: [id])
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads         Lead[]
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]

  @@index([companyId, name])
  @@index([ownerId])
}

model Lead {
  id             String     @id @default(cuid())
  companyId      String?
  title          String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  company        String?
  city           String?
  country        String?
  organizationId String?
  organization   CrmOrganization? @relation(fields: [organizationId], references: [id])
  source         LeadSource @default(OTHER)
  status         LeadStatus @default(NEW)
  priority       Priority   @default(MEDIUM)
  value          Float?
  score          Int        @default(0)
  tags           String[]   @default([])
  lostReason     String?
  notes          String?
  createdById    String
  createdBy      User       @relation("LeadCreatedBy", fields: [createdById], references: [id])
  assignedToId   String?
  assignedTo     User?      @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  importBatchId  String?
  importBatch    LeadImportBatch? @relation(fields: [importBatchId], references: [id])
  importRowNo    Int?
  lastContactedAt DateTime?
  qualifiedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  activities  Activity[]
  contacts    Contact[]
  opportunity Opportunity?

  @@index([status, source])
  @@index([assignedToId, status])
  @@index([email])
  @@index([phone])
  @@index([organizationId])
  @@index([importBatchId])
  @@index([companyId])
}

model CrmAssignmentRule {
  id          String     @id @default(cuid())
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id])
  name        String
  isActive    Boolean    @default(true)
  priority    Int        @default(100)
  source      LeadSource?
  city        String?
  country     String?
  minValue    Float?
  maxValue    Float?
  assignToId  String
  assignTo    User       @relation("CrmAssignmentRuleAssignee", fields: [assignToId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyId, isActive, priority])
  @@index([assignToId])
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  EMAIL
  PHONE
  ADVERTISEMENT
  CSV_IMPORT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model LeadImportBatch {
  id          String           @id @default(cuid())
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id])
  fileName    String
  status      LeadImportStatus @default(PENDING)
  totalRows   Int              @default(0)
  createdRows Int              @default(0)
  skippedRows Int              @default(0)
  failedRows  Int              @default(0)
  duplicateRows Int            @default(0)
  importedById String
  importedBy   User            @relation("LeadImportBy", fields: [importedById], references: [id])
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  errorSummary String?
  createdAt    DateTime        @default(now())

  rows  LeadImportRow[]
  leads Lead[]

  @@index([companyId, createdAt])
  @@index([importedById, createdAt])
}

enum LeadImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model LeadImportRow {
  id        String              @id @default(cuid())
  batchId   String
  batch     LeadImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNo     Int
  status    LeadImportRowStatus
  rawData   Json
  normalizedData Json?
  leadId    String?
  error     String?
  duplicateLeadId String?
  createdAt DateTime @default(now())

  @@unique([batchId, rowNo])
  @@index([batchId, status])
}

enum LeadImportRowStatus {
  CREATED
  SKIPPED
  FAILED
  DUPLICATE
}

model Contact {
  id             String   @id @default(cuid())
  companyId      String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  mobile         String?
  company        String?
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id])
  organizationId String?
  organization   CrmOrganization? @relation(fields: [organizationId], references: [id])
  position       String?
  address        String?
  city           String?
  country        String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activities    Activity[]
  opportunities Opportunity[]
  customers     Customer[]

  @@index([email])
  @@index([phone])
  @@index([leadId])
  @@index([organizationId])
  @@index([companyId])
}

model Opportunity {
  id             String           @id @default(cuid())
  companyId      String?
  title          String
  leadId         String?          @unique
  lead           Lead?            @relation(fields: [leadId], references: [id])
  contactId      String?
  contact        Contact?         @relation(fields: [contactId], references: [id])
  organizationId String?
  organization   CrmOrganization? @relation(fields: [organizationId], references: [id])
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  quotationId     String?
  quotation       Quotation?       @relation("OpportunityQuotation", fields: [quotationId], references: [id])
  salesOrderId    String?
  salesOrder      SalesOrder?      @relation("OpportunitySalesOrder", fields: [salesOrderId], references: [id])
  value          Float
  currency       String           @default("USD")
  stage          OpportunityStage @default(PROSPECTING)
  probability    Int              @default(0)
  expectedClose  DateTime?
  lostReason     String?
  erpSyncStatus  CrmSyncStatus    @default(NOT_SYNCED)
  erpSyncError    String?
  wonAt          DateTime?
  lostAt         DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  activities Activity[]
  items      OpportunityItem[]

  @@index([stage, expectedClose])
  @@index([organizationId])
  @@index([customerId])
  @@index([quotationId])
  @@index([salesOrderId])
  @@index([companyId])
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
