generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================== AUTH =====================
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  avatar            String?
  role              UserRole  @default(EMPLOYEE)
  tokenVersion      Int       @default(0)
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?
  companyId         String?
  company           Company?  @relation("CompanyUsers", fields: [companyId], references: [id])
  ownedCompanies    Company[] @relation("CompanyOwner")
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee              Employee?
  accessRoles           UserAccessRole[]
  permissionOverrides   UserPermissionOverride[]
  accessAuditLogs       AccessAuditLog[]         @relation("AccessAuditActor")
  createdLeads          Lead[]                   @relation("LeadCreatedBy")
  assignedLeads         Lead[]                   @relation("LeadAssignedTo")
  activities            Activity[]
  tasks                 Task[]                   @relation("TaskAssignee")
  createdTasks          Task[]                   @relation("TaskCreator")
  comments              Comment[]
  notifications         Notification[]
  crmOrganizations      CrmOrganization[]        @relation("CrmOrganizationOwner")
  leadImportBatches     LeadImportBatch[]        @relation("LeadImportBy")
  crmSavedViews         CrmSavedView[]
  crmAssignmentRules    CrmAssignmentRule[]      @relation("CrmAssignmentRuleAssignee")
  createdSalesInvoices  SalesInvoice[]           @relation("SalesInvoiceCreatedBy")
  assignedSalesInvoices SalesInvoice[]           @relation("SalesInvoiceAssignedTo")
  tenantMemberships     TenantMembership[]
  companyMemberships    CompanyMembership[]
  refreshSessions       RefreshSession[]
  passwordResetTokens   PasswordResetToken[]
  recoveryCodes         TwoFactorRecoveryCode[]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  ACCOUNTANT
  HR_MANAGER
  HR_OFFICER
  PAYROLL_OFFICER
  SALES_REP
  PURCHASE_MANAGER
}

// ===================== COMPANY =====================
model Tenant {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String
  slug         String       @unique
  plan         String       @default("TRIAL")
  status       TenantStatus @default(ACTIVE)
  dataRegion   String       @default("in")
  baseCurrency String       @default("INR")
  timezone     String       @default("Asia/Kolkata")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  companies   Company[]
  memberships TenantMembership[]
  settings    PlatformSetting[]

  @@index([status, dataRegion])
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model TenantMembership {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOwner   Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId, isActive])
}

model Company {
  id              String   @id @default(cuid())
  tenantId        String?  @db.Uuid
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  legalName       String?
  gstin           String?
  pan             String?
  cin             String?
  fiscalYearStart Int      @default(4)
  name            String
  slug            String   @unique
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  country         String?
  zip             String?
  taxId           String?
  currency        String   @default("USD")
  logo            String?
  website         String?
  ownerId         String?
  owner           User?    @relation("CompanyOwner", fields: [ownerId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users               User[]                   @relation("CompanyUsers")
  accessRoles         AccessRole[]
  permissionOverrides UserPermissionOverride[]
  accessAuditLogs     AccessAuditLog[]
  crmOrganizations    CrmOrganization[]
  leadImportBatches   LeadImportBatch[]
  crmSavedViews       CrmSavedView[]
  crmAssignmentRules  CrmAssignmentRule[]
  shiftTypes          ShiftType[]
  leaveTypes          LeaveType[]
  leavePeriods        LeavePeriod[]
  leavePolicies       LeavePolicy[]
  salaryComponents    SalaryComponent[]
  salaryStructures    SalaryStructure[]
  payrollEntries      PayrollEntry[]
  branches            Branch[]
  memberships         CompanyMembership[]
  gstRegistrations    CompanyGstin[]

  @@unique([tenantId, gstin])
  @@index([tenantId, id])
}

model CompanyMembership {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String?  @db.Uuid
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultBranchId String?  @db.Uuid
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([companyId, userId])
  @@index([tenantId, userId, isActive])
}

model Branch {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String?  @db.Uuid
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  gstin           String?
  address         Json?
  isManufacturing Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId, isActive])
}

model CompanyGstin {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String?  @db.Uuid
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stateCode String
  gstin     String
  legalName String?
  address   Json?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, gstin])
  @@unique([companyId, stateCode])
  @@index([tenantId, companyId])
}

model RefreshSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String?   @db.Uuid
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  parentHash   String?
  companyId    String?
  branchId     String?   @db.Uuid
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  revokeReason String?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([tenantId, userId, revokedAt])
  @@index([familyId, revokedAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model LoginAttempt {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

enum PermissionAction {
  READ
  CREATE
  WRITE
  DELETE
  SUBMIT
  CANCEL
  AMEND
  APPROVE
  EXPORT
  IMPORT
  PRINT
  REPORT
  MANAGE
}

enum AccessEffect {
  ALLOW
  DENY
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  resource    String
  action      PermissionAction
  label       String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@unique([module, resource, action])
  @@index([module, action])
}

model AccessRole {
  id           String   @id @default(cuid())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  name         String
  title        String?
  description  String?
  isSystem     Boolean  @default(false)
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       UserAccessRole[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model UserAccessRole {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedAt   DateTime   @default(now())

  @@unique([userId, roleId])
  @@index([userId])
}

model RolePermission {
  id           String       @id @default(cuid())
  roleId       String
  role         AccessRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       AccessEffect @default(ALLOW)
  conditions   Json?
  createdAt    DateTime     @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId, effect])
}

model UserPermissionOverride {
  id           String       @id @default(cuid())
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       AccessEffect
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())

  @@unique([userId, permissionId])
  @@index([companyId, userId, effect])
}

model AccessAuditLog {
  id           String   @id @default(cuid())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  actorId      String?
  actor        User?    @relation("AccessAuditActor", fields: [actorId], references: [id])
  targetUserId String?
  targetRoleId String?
  action       String
  message      String?
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetRoleId, createdAt])
}

// ===================== ACCOUNTING =====================
model Account {
  id                        String       @id @default(cuid())
  companyId                 String?
  code                      String
  name                      String
  type                      AccountType
  subType                   String?
  parentId                  String?
  parent                    Account?     @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                  Account[]    @relation("AccountHierarchy")
  description               String?
  rootType                  AccountType?
  isGroup                   Boolean      @default(false)
  freezeAccount             Boolean      @default(false)
  frozenTillDate            DateTime?
  isDefaultCash             Boolean      @default(false)
  isDefaultBank             Boolean      @default(false)
  isDefaultReceivable       Boolean      @default(false)
  isDefaultPayable          Boolean      @default(false)
  isDefaultTax              Boolean      @default(false)
  isDefaultRoundOff         Boolean      @default(false)
  isDefaultRetainedEarnings Boolean      @default(false)
  isActive                  Boolean      @default(true)
  balance                   Decimal      @default(0) @db.Decimal(18, 6)
  currency                  String       @default("USD")
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  debitLines               JournalLine[]          @relation("DebitAccount")
  creditLines              JournalLine[]          @relation("CreditAccount")
  taxTemplateLines         TaxTemplateLine[]
  salesInvoiceTaxes        SalesInvoiceTax[]
  creditNoteTaxes          CreditNoteTax[]
  ledgerEntries            GeneralLedgerEntry[]
  budgets                  Budget[]
  bankStatementLines       BankStatementLine[]
  retainedEarningsClosings PeriodClosingVoucher[]
  fixedAssets              FixedAsset[]           @relation("AssetAccount")

  @@unique([companyId, code])
  @@index([companyId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model FiscalYear {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())

  periods         Period[]
  numberingSeries NumberingSeries[]

  @@index([companyId])
}

model Period {
  id           String     @id @default(cuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])
  isClosed     Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model JournalEntry {
  id            String           @id @default(cuid())
  companyId     String?
  entryNumber   String           @unique
  date          DateTime
  description   String
  reference     String?
  referenceType String?
  referenceId   String?
  entryType     JournalEntryType @default(STANDARD)
  fiscalYearId  String?
  periodId      String?
  status        EntryStatus      @default(DRAFT)
  totalDebit    Decimal          @default(0) @db.Decimal(18, 6)
  totalCredit   Decimal          @default(0) @db.Decimal(18, 6)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  lines JournalLine[]

  @@index([companyId])
}

enum JournalEntryType {
  STANDARD
  OPENING
  CLOSING
  RECURRING
  EXCHANGE_REVALUATION
  DEPRECIATION
}

enum EntryStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  CANCELLED
}

enum DocumentType {
  QUOTATION
  SALES_ORDER
  DELIVERY_NOTE
  SALES_INVOICE
  PAYMENT_ENTRY
  CREDIT_NOTE
  STOCK_ENTRY
  PURCHASE_ORDER
  PURCHASE_INVOICE
  MATERIAL_REQUEST
  REQUEST_FOR_QUOTATION
  SUPPLIER_QUOTATION
  PURCHASE_RECEIPT
  LANDED_COST_VOUCHER
  BLANKET_PURCHASE_ORDER
  QUALITY_INSPECTION
  BUYING_SETTINGS
  EMPLOYEE
  ATTENDANCE
  LEAVE_APPLICATION
  PAYROLL_ENTRY
  SALARY_SLIP
  EMPLOYEE_LIFECYCLE
  CUSTOMER
  SUPPLIER
  JOURNAL_ENTRY
  PAYMENT
  SUPPLIER_PAYMENT
  EWAY_BILL
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CREDITED
}

enum NumberingResetPeriod {
  NEVER
  FISCAL_YEAR
  MONTHLY
}

enum TaxChargeType {
  ON_NET_TOTAL
  ON_PREVIOUS_ROW_AMOUNT
  ON_PREVIOUS_ROW_TOTAL
}

enum TaxTemplateScope {
  ITEM
  INVOICE
  BOTH
}

enum PaymentEntryStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum PaymentAllocationType {
  INVOICE
  ADVANCE
  CREDIT_NOTE
}

enum LedgerVoucherType {
  JOURNAL_ENTRY
  SALES_INVOICE
  PURCHASE_INVOICE
  PURCHASE_RECEIPT
  SUPPLIER_PAYMENT
  LANDED_COST_VOUCHER
  PAYMENT_ENTRY
  CREDIT_NOTE
  STOCK_ENTRY
  PERIOD_CLOSING
  EXCHANGE_REVALUATION
  ASSET_DEPRECIATION
  CANCELLATION
}

enum CreditNoteReason {
  SALES_RETURN
  RATE_ADJUSTMENT
  DISCOUNT
  TAX_CORRECTION
  FULL_REVERSAL
  OTHER
}

enum RecurrenceFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum PrintFormatDocType {
  SALES_INVOICE
  CREDIT_NOTE
  PAYMENT_ENTRY
}

enum LifecycleEventType {
  ONBOARDING
  PROMOTION
  TRANSFER
  SEPARATION
}

enum LifecycleEventStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum CheckinType {
  IN
  OUT
}

enum ShiftAssignmentStatus {
  ACTIVE
  INACTIVE
}

enum LeaveLedgerEntryType {
  ALLOCATION
  APPLICATION
  ENCASHMENT
  EXPIRY
  ADJUSTMENT
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
  TAX
  BENEFIT
}

enum PayrollEntryStatus {
  DRAFT
  SUBMITTED
  PAID
  CANCELLED
}

enum SalarySlipStatus {
  DRAFT
  SUBMITTED
  PAID
  CANCELLED
}

model JournalLine {
  id              String       @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  debitAccountId  String?
  debitAccount    Account?     @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccountId String?
  creditAccount   Account?     @relation("CreditAccount", fields: [creditAccountId], references: [id])
  debit           Decimal      @default(0) @db.Decimal(18, 6)
  credit          Decimal      @default(0) @db.Decimal(18, 6)
  currency        String       @default("USD")
  exchangeRate    Decimal      @default(1) @db.Decimal(18, 6)
  costCenterId    String?
  costCenter      CostCenter?  @relation(fields: [costCenterId], references: [id])
  description     String?
  createdAt       DateTime     @default(now())
}

model CostCenter {
  id        String       @id @default(cuid())
  companyId String?
  code      String
  name      String
  parentId  String?
  parent    CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id])
  children  CostCenter[] @relation("CostCenterTree")
  isGroup   Boolean      @default(false)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  journalLines     JournalLine[]
  ledgerEntries    GeneralLedgerEntry[]
  budgets          Budget[]
  materialRequests MaterialRequest[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([companyId, code])
  @@index([parentId])
  @@index([companyId])
}

model NumberingSeries {
  id           String               @id @default(cuid())
  tenantId     String?              @db.Uuid
  companyId    String?
  documentType DocumentType
  name         String
  pattern      String
  prefix       String?
  suffix       String?
  current      Int                  @default(0)
  digits       Int                  @default(5)
  resetPeriod  NumberingResetPeriod @default(FISCAL_YEAR)
  fiscalYearId String?
  fiscalYear   FiscalYear?          @relation(fields: [fiscalYearId], references: [id])
  branch       String?
  branchId     String?              @db.Uuid
  gstin        String?
  isDefault    Boolean              @default(false)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([tenantId, companyId, documentType, name, fiscalYearId, branchId, gstin])
  @@index([tenantId, companyId])
  @@index([documentType, isDefault, isActive])
}

// ===================== INVENTORY =====================
model Category {
  id          String     @id @default(cuid())
  companyId   String?
  name        String
  code        String?
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Unit {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  symbol    String
  createdAt DateTime @default(now())

  products          Product[]
  salesInvoiceItems SalesInvoiceItem[]
  subscriptionItems SubscriptionTemplateItem[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Product {
  id                          String                  @id @default(cuid())
  companyId                   String?
  sku                         String
  name                        String
  description                 String?
  categoryId                  String?
  category                    Category?               @relation(fields: [categoryId], references: [id])
  unitId                      String?
  unit                        Unit?                   @relation(fields: [unitId], references: [id])
  type                        ProductType             @default(PRODUCT)
  costPrice                   Decimal                 @default(0) @db.Decimal(18, 6)
  salePrice                   Decimal                 @default(0) @db.Decimal(18, 6)
  taxRate                     Decimal                 @default(0) @db.Decimal(9, 4)
  minStockLevel               Decimal                 @default(0) @db.Decimal(18, 6)
  maxStockLevel               Decimal?                @db.Decimal(18, 6)
  valuationMethod             ValuationMethod         @default(MOVING_AVERAGE)
  maintainStock               Boolean                 @default(true)
  allowNegativeStock          Boolean                 @default(false)
  hasBatchNo                  Boolean                 @default(false)
  hasSerialNo                 Boolean                 @default(false)
  reorderLevel                Decimal                 @default(0) @db.Decimal(18, 6)
  reorderQty                  Decimal                 @default(0) @db.Decimal(18, 6)
  brand                       String?
  manufacturer                String?
  isActive                    Boolean                 @default(true)
  image                       String?
  barcode                     String?
  weight                      Decimal?                @db.Decimal(18, 6)
  hsnCode                     String?
  taxCode                     String?
  defaultTaxTemplateId        String?
  defaultTaxTemplate          TaxTemplate?            @relation("ProductDefaultTaxTemplate", fields: [defaultTaxTemplateId], references: [id])
  defaultWarehouseId          String?
  itemNature                  InventoryItemNature     @default(STOCK)
  shelfLifeDays               Int?
  receiptInspectionRequired   Boolean                 @default(false)
  inProcessInspectionRequired Boolean                 @default(false)
  finalInspectionRequired     Boolean                 @default(false)
  safetyStock                 Decimal                 @default(0) @db.Decimal(18, 6)
  leadTimeDays                Int                     @default(0)
  minimumOrderQty             Decimal                 @default(0) @db.Decimal(18, 6)
  orderMultiple               Decimal                 @default(1) @db.Decimal(18, 6)
  backflush                   Boolean                 @default(false)
  drawingReference            String?
  revisionReference           String?
  batchAllocationStrategy     BatchAllocationStrategy @default(FIFO)
  inventoryAccountId          String?
  cogsAccountId               String?
  stockAdjustmentAccountId    String?
  isVariant                   Boolean                 @default(false)
  variantOfId                 String?
  variantOf                   Product?                @relation("ProductVariants", fields: [variantOfId], references: [id])
  variants                    Product[]               @relation("ProductVariants")
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  stockLevels               StockLevel[]
  movements                 StockMovement[]
  deliveryNoteItems         DeliveryNoteItem[]
  salesOrderItems           SalesOrderItem[]
  purchaseOrderItems        PurchaseOrderItem[]
  materialRequestItems      MaterialRequestItem[]
  rfqItems                  RequestForQuotationItem[]
  supplierQuotationItems    SupplierQuotationItem[]
  blanketPurchaseOrderItems BlanketPurchaseOrderItem[]
  purchaseReceiptItems      PurchaseReceiptItem[]
  salesInvoiceItems         SalesInvoiceItem[]
  purchaseInvoiceItems      PurchaseInvoiceItem[]
  quotationItems            QuotationItem[]
  salesEnquiryItems         SalesEnquiryItem[]
  creditNoteItems           CreditNoteItem[]
  subscriptionItems         SubscriptionTemplateItem[]
  opportunityItems          OpportunityItem[]
  stockLedgerEntries        StockLedgerEntry[]
  valuationLayers           InventoryValuationLayer[]
  stockReservations         StockReservation[]
  stockEntryItems           StockEntryItem[]
  qualityInspections        QualityInspection[]
  batches                   Batch[]
  serialNumbers             SerialNumber[]
  itemPrices                ItemPrice[]
  supplierItems             SupplierItem[]
  uomConversions            ProductUomConversion[]
  attributeValues           ProductAttributeValue[]
  warehouseRules            ProductWarehouseRule[]
  customerCodes             CustomerItemCode[]
  batchInputs               BatchGenealogy[]           @relation("BatchInput")
  batchOutputs              BatchGenealogy[]           @relation("BatchOutput")

  @@unique([companyId, sku])
  @@index([variantOfId])
  @@index([defaultWarehouseId])
  @@index([companyId])
}

enum ProductType {
  PRODUCT
  SERVICE
  DIGITAL
}

enum InventoryItemNature {
  STOCK
  NON_STOCK
  SERVICE
  RAW_MATERIAL
  WIP
  FINISHED_GOOD
  CONSUMABLE
  ASSET
}

enum BatchAllocationStrategy {
  FIFO
  FEFO
  MANUAL
}

model ProductWarehouseRule {
  id              String    @id @default(cuid())
  companyId       String?
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  reorderLevel    Decimal   @default(0) @db.Decimal(18, 6)
  reorderQty      Decimal   @default(0) @db.Decimal(18, 6)
  safetyStock     Decimal   @default(0) @db.Decimal(18, 6)
  leadTimeDays    Int       @default(0)
  minimumOrderQty Decimal   @default(0) @db.Decimal(18, 6)
  orderMultiple   Decimal   @default(1) @db.Decimal(18, 6)
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([companyId, warehouseId])
}

model CustomerItemCode {
  id           String   @id @default(cuid())
  companyId    String?
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String
  customerCode String
  description  String?
  createdAt    DateTime @default(now())

  @@unique([customerId, productId])
  @@unique([customerId, customerCode])
}

enum ValuationMethod {
  FIFO
  MOVING_AVERAGE
  STANDARD
}

model Warehouse {
  id           String             @id @default(cuid())
  name         String
  code         String
  parentId     String?
  parent       Warehouse?         @relation("WarehouseTree", fields: [parentId], references: [id])
  children     Warehouse[]        @relation("WarehouseTree")
  type         WarehouseType      @default(WAREHOUSE)
  companyId    String?
  tenantId     String?            @db.Uuid
  branchId     String?            @db.Uuid
  plantId      String?            @db.Uuid
  stockType    WarehouseStockType @default(STORES)
  locationPath String?
  isFrozen     Boolean            @default(false)
  frozenAt     DateTime?
  frozenById   String?
  address      String?
  city         String?
  country      String?
  stateCode    String?
  pincode      String?
  gstin        String?
  isDefault    Boolean            @default(false)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  stockLevels           StockLevel[]
  movements             StockMovement[]
  deliveryNotes         DeliveryNote[]
  stockLedgerEntries    StockLedgerEntry[]
  valuationLayers       InventoryValuationLayer[]
  stockReservations     StockReservation[]
  stockEntriesFrom      StockEntry[]              @relation("StockEntryFromWarehouse")
  stockEntriesTo        StockEntry[]              @relation("StockEntryToWarehouse")
  stockEntryItems       StockEntryItem[]
  materialRequestItems  MaterialRequestItem[]
  purchaseReceiptItems  PurchaseReceiptItem[]
  batches               Batch[]
  serialNumbers         SerialNumber[]
  productRules          ProductWarehouseRule[]
  reconciliations       StockReconciliation[]
  transferOrdersFrom    StockTransferOrder[]      @relation("TransferSource")
  transferOrdersTransit StockTransferOrder[]      @relation("TransferTransit")
  transferOrdersTo      StockTransferOrder[]      @relation("TransferDestination")

  @@unique([companyId, code])
  @@index([parentId])
  @@index([companyId])
}

enum WarehouseType {
  COMPANY
  BRANCH
  ROOM
  BIN
  WAREHOUSE
}

enum WarehouseStockType {
  STORES
  WIP
  FINISHED_GOODS
  QC_HOLD
  REJECTED
  SCRAP
  GOODS_IN_TRANSIT
  SUPPLIER_JOB_WORKER
}

model StockLevel {
  id          String    @id @default(cuid())
  companyId   String?
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(18, 6)
  reservedQty Decimal   @default(0) @db.Decimal(18, 6)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([companyId])
}

model StockMovement {
  id          String       @id @default(cuid())
  companyId   String?
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  type        MovementType
  quantity    Decimal      @db.Decimal(18, 6)
  unitCost    Decimal?     @db.Decimal(18, 6)
  reference   String?
  notes       String?
  createdAt   DateTime     @default(now())

  @@index([companyId])
}

model StockLedgerEntry {
  id                   String             @id @default(cuid())
  companyId            String?
  productId            String
  product              Product            @relation(fields: [productId], references: [id])
  warehouseId          String
  warehouse            Warehouse          @relation(fields: [warehouseId], references: [id])
  postingDate          DateTime           @default(now())
  voucherType          String
  voucherId            String?
  voucherNo            String
  actualQty            Decimal            @db.Decimal(18, 6)
  qtyAfterTransaction  Decimal            @db.Decimal(18, 6)
  incomingRate         Decimal?           @db.Decimal(18, 6)
  outgoingRate         Decimal?           @db.Decimal(18, 6)
  valuationRate        Decimal            @default(0) @db.Decimal(18, 6)
  stockValue           Decimal            @default(0) @db.Decimal(18, 6)
  stockValueDifference Decimal            @default(0) @db.Decimal(18, 6)
  batchId              String?
  batch                Batch?             @relation(fields: [batchId], references: [id])
  serialNoId           String?
  serialNo             SerialNumber?      @relation(fields: [serialNoId], references: [id])
  isCancelled          Boolean            @default(false)
  reversalOfId         String?
  reversalOf           StockLedgerEntry?  @relation("StockLedgerReversal", fields: [reversalOfId], references: [id])
  reversals            StockLedgerEntry[] @relation("StockLedgerReversal")
  repostVersion        Int                @default(1)
  remarks              String?
  createdAt            DateTime           @default(now())

  @@index([productId, warehouseId, postingDate])
  @@index([voucherType, voucherId])
  @@index([batchId])
  @@index([serialNoId])
  @@index([companyId])
}

model InventoryValuationLayer {
  id                  String    @id @default(cuid())
  companyId           String?
  productId           String
  product             Product   @relation(fields: [productId], references: [id])
  warehouseId         String
  warehouse           Warehouse @relation(fields: [warehouseId], references: [id])
  sourceLedgerEntryId String?
  postingDate         DateTime  @default(now())
  originalQty         Decimal   @db.Decimal(18, 6)
  remainingQty        Decimal   @db.Decimal(18, 6)
  rate                Decimal   @db.Decimal(18, 6)
  isClosed            Boolean   @default(false)
  createdAt           DateTime  @default(now())

  @@index([productId, warehouseId, isClosed, postingDate])
  @@index([companyId])
}

model StockReservation {
  id               String                  @id @default(cuid())
  companyId        String?
  productId        String
  product          Product                 @relation(fields: [productId], references: [id])
  warehouseId      String
  warehouse        Warehouse               @relation(fields: [warehouseId], references: [id])
  salesOrderId     String?
  salesOrder       SalesOrder?             @relation(fields: [salesOrderId], references: [id])
  salesOrderItemId String?
  salesOrderItem   SalesOrderItem?         @relation(fields: [salesOrderItemId], references: [id])
  workOrderId      String?                 @db.Uuid
  workOrder        ManufacturingWorkOrder? @relation(fields: [workOrderId], references: [id])
  reservedQty      Decimal                 @db.Decimal(18, 6)
  fulfilledQty     Decimal                 @default(0) @db.Decimal(18, 6)
  status           StockReservationStatus  @default(ACTIVE)
  expiresAt        DateTime?
  releasedAt       DateTime?
  releaseReason    String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([productId, warehouseId, status])
  @@index([salesOrderId])
  @@index([salesOrderItemId])
  @@index([workOrderId])
  @@index([companyId])
}

enum StockReservationStatus {
  ACTIVE
  PARTIAL
  FULFILLED
  RELEASED
}

model StockEntry {
  id                 String            @id @default(cuid())
  companyId          String?
  entryNo            String            @unique
  purpose            StockEntryPurpose
  status             DocumentStatus    @default(DRAFT)
  postingDate        DateTime          @default(now())
  fromWarehouseId    String?
  fromWarehouse      Warehouse?        @relation("StockEntryFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId      String?
  toWarehouse        Warehouse?        @relation("StockEntryToWarehouse", fields: [toWarehouseId], references: [id])
  remarks            String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  approvalInstanceId String?           @db.Uuid
  mrpSuggestionId    String?
  cancelledAt        DateTime?
  amendedFromId      String?
  amendedFrom        StockEntry?       @relation("StockEntryAmendments", fields: [amendedFromId], references: [id])
  amendments         StockEntry[]      @relation("StockEntryAmendments")
  revisionNo         Int               @default(1)
  sourceDocumentType String?
  sourceDocumentId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  items StockEntryItem[]

  @@index([status, purpose])
  @@index([postingDate])
  @@index([companyId])
}

model StockEntryItem {
  id            String     @id @default(cuid())
  stockEntryId  String
  stockEntry    StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  quantity      Decimal    @db.Decimal(18, 6)
  valuationRate Decimal    @default(0) @db.Decimal(18, 6)
  batchId       String?
  serialNoId    String?
  remarks       String?
  createdAt     DateTime   @default(now())

  @@index([stockEntryId])
  @@index([productId])
}

enum StockEntryPurpose {
  MATERIAL_RECEIPT
  MATERIAL_ISSUE
  MATERIAL_TRANSFER
  STOCK_RECONCILIATION
  OPENING_STOCK
  REPACK
  MANUFACTURE
  SCRAP
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  JOB_WORK_ISSUE
  JOB_WORK_RECEIPT
}

model Batch {
  id                String     @id @default(cuid())
  companyId         String?
  batchNo           String
  productId         String
  product           Product    @relation(fields: [productId], references: [id])
  warehouseId       String?
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id])
  expiryDate        DateTime?
  manufacturingDate DateTime?
  supplierBatchNo   String?
  supplierId        String?
  quantity          Decimal    @default(0) @db.Decimal(18, 6)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  ledgerEntries StockLedgerEntry[]
  parentLinks   BatchGenealogy[]   @relation("OutputBatch")
  childLinks    BatchGenealogy[]   @relation("InputBatch")

  @@unique([companyId, batchNo])
  @@index([productId, warehouseId])
  @@index([expiryDate])
  @@index([companyId])
}

model SerialNumber {
  id           String             @id @default(cuid())
  companyId    String?
  serialNo     String
  productId    String
  product      Product            @relation(fields: [productId], references: [id])
  warehouseId  String?
  warehouse    Warehouse?         @relation(fields: [warehouseId], references: [id])
  status       SerialNumberStatus @default(AVAILABLE)
  batchId      String?
  purchaseRate Decimal?           @db.Decimal(18, 6)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  ledgerEntries StockLedgerEntry[]

  @@unique([companyId, serialNo])
  @@index([productId, status])
  @@index([warehouseId])
  @@index([companyId])
}

model BatchGenealogy {
  id              String   @id @default(cuid())
  companyId       String?
  outputBatchId   String
  outputBatch     Batch    @relation("OutputBatch", fields: [outputBatchId], references: [id])
  inputBatchId    String
  inputBatch      Batch    @relation("InputBatch", fields: [inputBatchId], references: [id])
  outputProductId String
  outputProduct   Product  @relation("BatchOutput", fields: [outputProductId], references: [id])
  inputProductId  String
  inputProduct    Product  @relation("BatchInput", fields: [inputProductId], references: [id])
  quantityUsed    Decimal  @db.Decimal(18, 6)
  stockEntryId    String?
  createdAt       DateTime @default(now())

  @@unique([outputBatchId, inputBatchId, stockEntryId])
  @@index([inputBatchId])
  @@index([outputBatchId])
}

enum SerialNumberStatus {
  AVAILABLE
  DELIVERED
  RESERVED
  SCRAPPED
}

enum StockReconciliationStatus {
  DRAFT
  COUNTING
  PENDING_APPROVAL
  APPROVED
  SUBMITTED
  CANCELLED
}

model StockReconciliation {
  id                 String                    @id @default(cuid())
  companyId          String?
  reconciliationNo   String                    @unique
  warehouseId        String
  warehouse          Warehouse                 @relation(fields: [warehouseId], references: [id])
  status             StockReconciliationStatus @default(DRAFT)
  blindCount         Boolean                   @default(false)
  snapshotAt         DateTime?
  frozenAt           DateTime?
  varianceThreshold  Decimal                   @default(0) @db.Decimal(18, 6)
  approvalInstanceId String?                   @db.Uuid
  adjustmentEntryId  String?
  notes              String?
  countedById        String?
  submittedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  items              StockReconciliationItem[]

  @@index([companyId, status, createdAt])
  @@index([warehouseId, snapshotAt])
}

model StockReconciliationItem {
  id               String              @id @default(cuid())
  reconciliationId String
  reconciliation   StockReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  productId        String
  batchId          String?
  serialNoId       String?
  bookQty          Decimal             @default(0) @db.Decimal(18, 6)
  countedQty       Decimal?            @db.Decimal(18, 6)
  varianceQty      Decimal             @default(0) @db.Decimal(18, 6)
  valuationRate    Decimal             @default(0) @db.Decimal(18, 6)
  varianceValue    Decimal             @default(0) @db.Decimal(18, 6)
  countNotes       String?
  countedAt        DateTime?

  @@unique([reconciliationId, productId, batchId, serialNoId])
  @@index([productId])
}

enum StockTransferStatus {
  DRAFT
  SUBMITTED
  DISPATCHED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model StockTransferOrder {
  id                     String                   @id @default(cuid())
  companyId              String?
  transferNo             String                   @unique
  status                 StockTransferStatus      @default(DRAFT)
  sourceWarehouseId      String
  sourceWarehouse        Warehouse                @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  transitWarehouseId     String?
  transitWarehouse       Warehouse?               @relation("TransferTransit", fields: [transitWarehouseId], references: [id])
  destinationWarehouseId String
  destinationWarehouse   Warehouse                @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])
  crossPlant             Boolean                  @default(false)
  transporter            String?
  vehicleNo              String?
  trackingReference      String?
  dispatchEntryId        String?
  receiptEntryId         String?
  dispatchedAt           DateTime?
  receivedAt             DateTime?
  cancelledAt            DateTime?
  notes                  String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  items                  StockTransferOrderItem[]

  @@index([companyId, status, createdAt])
  @@index([sourceWarehouseId, destinationWarehouseId])
}

model StockTransferOrderItem {
  id              String             @id @default(cuid())
  transferOrderId String
  transferOrder   StockTransferOrder @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)
  productId       String
  quantity        Decimal            @db.Decimal(18, 6)
  dispatchedQty   Decimal            @default(0) @db.Decimal(18, 6)
  receivedQty     Decimal            @default(0) @db.Decimal(18, 6)
  damagedQty      Decimal            @default(0) @db.Decimal(18, 6)
  lostQty         Decimal            @default(0) @db.Decimal(18, 6)
  batchId         String?
  serialNoId      String?
  valuationRate   Decimal            @default(0) @db.Decimal(18, 6)

  @@index([transferOrderId])
  @@index([productId])
}

model InventoryWorkOrder {
  id                 String    @id @default(cuid())
  companyId          String?
  workOrderNo        String    @unique
  materialRequestId  String?
  productId          String
  warehouseId        String?
  quantity           Decimal   @db.Decimal(18, 6)
  producedQty        Decimal   @default(0) @db.Decimal(18, 6)
  requiredBy         DateTime?
  status             String    @default("DRAFT")
  sourceDocumentType String?
  sourceDocumentId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companyId, status])
  @@index([materialRequestId])
}

model PriceList {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  currency  String   @default("USD")
  selling   Boolean  @default(true)
  buying    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemPrices   ItemPrice[]
  pricingRules PricingRule[]

  @@unique([companyId, name])
  @@index([companyId])
}

model ItemPrice {
  id            String    @id @default(cuid())
  companyId     String?
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  priceListId   String
  priceList     PriceList @relation(fields: [priceListId], references: [id])
  unitId        String?
  customerId    String?
  customerGroup String?
  territory     String?
  salesChannel  String?
  minQty        Decimal?  @db.Decimal(18, 6)
  maxQty        Decimal?  @db.Decimal(18, 6)
  currency      String    @default("USD")
  price         Decimal   @db.Decimal(18, 6)
  validFrom     DateTime?
  validTo       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId, priceListId, customerId])
  @@index([companyId])
}

model PricingRule {
  id                   String     @id @default(cuid())
  companyId            String?
  name                 String
  priceListId          String?
  priceList            PriceList? @relation(fields: [priceListId], references: [id])
  productId            String?
  categoryId           String?
  customerId           String?
  customerGroup        String?
  territory            String?
  salesChannel         String?
  currency             String?
  isPromotional        Boolean    @default(false)
  minimumMarginPercent Decimal?   @db.Decimal(9, 4)
  requiresApproval     Boolean    @default(false)
  minQty               Decimal?   @db.Decimal(18, 6)
  maxQty               Decimal?   @db.Decimal(18, 6)
  discountPercent      Decimal    @default(0) @db.Decimal(9, 4)
  marginPercent        Decimal    @default(0) @db.Decimal(9, 4)
  priority             Int        @default(100)
  isActive             Boolean    @default(true)
  validFrom            DateTime?
  validTo              DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([isActive, priority])
  @@index([productId])
  @@index([categoryId])
  @@index([customerId])
  @@index([companyId])
}

model ProductUomConversion {
  id         String   @id @default(cuid())
  companyId  String?
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  fromUnitId String
  toUnitId   String
  factor     Decimal  @db.Decimal(18, 6)
  createdAt  DateTime @default(now())

  @@unique([productId, fromUnitId, toUnitId])
  @@index([companyId])
}

model ProductAttribute {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  values ProductAttributeValue[]

  @@unique([companyId, name])
  @@index([companyId])
}

model ProductAttributeValue {
  id          String           @id @default(cuid())
  companyId   String?
  attributeId String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  value       String
  createdAt   DateTime         @default(now())

  @@index([attributeId])
  @@index([productId])
  @@index([companyId])
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

// ===================== HR =====================
model Department {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  code        String
  managerId   String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  positions Position[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Position {
  id           String     @id @default(cuid())
  companyId    String?
  title        String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  description  String?
  minSalary    Float?
  maxSalary    Float?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  employees Employee[]

  @@index([companyId])
}

model Employee {
  id               String         @id @default(cuid())
  employeeId       String         @unique
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  departmentId     String?
  department       Department?    @relation(fields: [departmentId], references: [id])
  positionId       String?
  position         Position?      @relation(fields: [positionId], references: [id])
  managerId        String?
  manager          Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates     Employee[]     @relation("EmployeeManager")
  hireDate         DateTime
  terminatedDate   DateTime?
  salary           Float
  salaryType       SalaryType     @default(MONTHLY)
  employmentType   String?
  branch           String?
  grade            String?
  gender           String?
  dateOfBirth      DateTime?
  maritalStatus    String?
  workLocation     String?
  personalEmail    String?
  companyEmail     String?
  noticePeriodDays Int?
  bankAccount      String?
  bankName         String?
  taxId            String?
  address          String?
  city             String?
  country          String?
  emergencyName    String?
  emergencyPhone   String?
  status           EmployeeStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  attendance             Attendance[]
  leaveRequests          LeaveRequest[]
  payrolls               Payroll[]
  checkins               EmployeeCheckin[]
  shiftAssignments       ShiftAssignment[]
  leaveAllocations       LeaveAllocation[]
  leaveLedgerEntries     LeaveLedgerEntry[]
  leavePolicyAssignments LeavePolicyAssignment[]
  salaryAssignments      SalaryStructureAssignment[]
  salarySlips            SalarySlip[]
  lifecycleEvents        EmployeeLifecycleEvent[]
}

enum SalaryType {
  HOURLY
  DAILY
  MONTHLY
  ANNUAL
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  PROBATION
}

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  status      AttendanceStatus @default(PRESENT)
  notes       String?
  createdAt   DateTime         @default(now())

  @@unique([employeeId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
}

model LeaveType {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  name        String
  daysAllowed Int
  isPaid      Boolean  @default(true)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  leaveRequests LeaveRequest[]
  policyDetails LeavePolicyDetail[]
  allocations   LeaveAllocation[]
  ledgerEntries LeaveLedgerEntry[]

  @@index([companyId])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  days        Float
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
