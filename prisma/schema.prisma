// ===================== SALES =====================
enum SalesEnquiryStatus {
  DRAFT
  SUBMITTED
  QUOTED
  LOST
  CANCELLED
}

enum SalesSupplyMode {
  MAKE_TO_STOCK
  MAKE_TO_ORDER
}

enum SalesCreditStatus {
  NOT_CHECKED
  PASSED
  BLOCKED
  APPROVED
}

enum SalesTaxMode {
  CGST_SGST
  IGST
  EXPORT
  SEZ
  NONE
}

model SalesEnquiry {
  id                   String             @id @default(cuid())
  companyId            String?
  enquiryNo            String             @unique
  customerId           String
  customer             Customer           @relation(fields: [customerId], references: [id])
  opportunityId        String?
  status               SalesEnquiryStatus @default(DRAFT)
  requirements         String?
  targetDate           DateTime?
  currency             String             @default("USD")
  territory            String?
  salesChannel         String?
  branchId             String?            @db.Uuid
  submittedAt          DateTime?
  convertedQuotationId String?            @unique
  convertedQuotation   Quotation?         @relation("EnquiryQuotation", fields: [convertedQuotationId], references: [id])
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  items                SalesEnquiryItem[]

  @@index([companyId, status, createdAt])
  @@index([customerId, status])
  @@index([opportunityId])
}

model SalesEnquiryItem {
  id          String       @id @default(cuid())
  enquiryId   String
  enquiry     SalesEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  description String?
  targetQty   Decimal      @db.Decimal(18, 6)
  targetDate  DateTime?
  targetPrice Decimal?     @db.Decimal(18, 6)
  uomId       String?
  createdAt   DateTime     @default(now())
}

model Quotation {
  id                      String          @id @default(cuid())
  companyId               String?
  quotationNo             String          @unique
  customerId              String
  customer                Customer        @relation(fields: [customerId], references: [id])
  date                    DateTime        @default(now())
  validUntil              DateTime?
  status                  QuotationStatus @default(DRAFT)
  subtotal                Decimal         @default(0) @db.Decimal(18, 6)
  taxAmount               Decimal         @default(0) @db.Decimal(18, 6)
  discount                Decimal         @default(0) @db.Decimal(18, 6)
  total                   Decimal         @default(0) @db.Decimal(18, 6)
  currency                String          @default("USD")
  notes                   String?
  terms                   String?
  enquirySource           SalesEnquiry?   @relation("EnquiryQuotation")
  revisionNo              Int             @default(1)
  supersedesId            String?
  supersedes              Quotation?      @relation("QuotationRevisions", fields: [supersedesId], references: [id])
  revisions               Quotation[]     @relation("QuotationRevisions")
  submittedAt             DateTime?
  sentAt                  DateTime?
  openedAt                DateTime?
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  rejectionReason         String?
  commercialConditions    Json?
  billingAddressSnapshot  Json?
  shippingAddressSnapshot Json?
  branchId                String?         @db.Uuid
  placeOfSupply           String?
  taxMode                 SalesTaxMode    @default(NONE)
  deliveryTerms           String?
  transporterInfo         Json?
  approvalInstanceId      String?         @db.Uuid
  publicToken             String?         @unique
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  items            QuotationItem[]
  salesOrders      SalesOrder[]
  crmOpportunities Opportunity[]   @relation("OpportunityQuotation")

  @@index([companyId])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model QuotationItem {
  id            String    @id @default(cuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  description   String?
  quantity      Decimal   @db.Decimal(18, 6)
  unitPrice     Decimal   @db.Decimal(18, 6)
  taxRate       Decimal   @default(0) @db.Decimal(9, 4)
  discount      Decimal   @default(0) @db.Decimal(9, 4)
  total         Decimal   @db.Decimal(18, 6)
  uomId         String?
  costRate      Decimal   @default(0) @db.Decimal(18, 6)
  marginPercent Decimal   @default(0) @db.Decimal(9, 4)
  priceSource   String?
  createdAt     DateTime  @default(now())
}

model SalesOrder {
  id                      String            @id @default(cuid())
  companyId               String?
  orderNo                 String            @unique
  customerId              String
  customer                Customer          @relation(fields: [customerId], references: [id])
  quotationId             String?
  quotation               Quotation?        @relation(fields: [quotationId], references: [id])
  customerPoNo            String?
  sourceWarehouseId       String?
  date                    DateTime          @default(now())
  deliveryDate            DateTime?
  status                  SalesOrderStatus  @default(DRAFT)
  subtotal                Decimal           @default(0) @db.Decimal(18, 6)
  taxAmount               Decimal           @default(0) @db.Decimal(18, 6)
  discount                Decimal           @default(0) @db.Decimal(18, 6)
  total                   Decimal           @default(0) @db.Decimal(18, 6)
  deliveredPercent        Decimal           @default(0) @db.Decimal(9, 4)
  billedPercent           Decimal           @default(0) @db.Decimal(9, 4)
  amountBilled            Decimal           @default(0) @db.Decimal(18, 6)
  holdReason              String?
  currency                String            @default("USD")
  notes                   String?
  terms                   String?
  revisionNo              Int               @default(1)
  amendedFromId           String?
  amendedFrom             SalesOrder?       @relation("SalesOrderAmendments", fields: [amendedFromId], references: [id])
  amendments              SalesOrder[]      @relation("SalesOrderAmendments")
  submittedAt             DateTime?
  cancelledAt             DateTime?
  cancelReason            String?
  resumedAt               DateTime?
  closedAt                DateTime?
  shortCloseReason        String?
  creditStatus            SalesCreditStatus @default(NOT_CHECKED)
  creditBlockReason       String?
  approvalInstanceId      String?           @db.Uuid
  branchId                String?           @db.Uuid
  territory               String?
  salesChannel            String?
  billingAddressSnapshot  Json?
  shippingAddressSnapshot Json?
  placeOfSupply           String?
  taxMode                 SalesTaxMode      @default(NONE)
  deliveryTerms           String?
  transporterInfo         Json?
  eWayBillNo              String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  items             SalesOrderItem[]
  deliveryNotes     DeliveryNote[]
  invoices          SalesInvoice[]
  crmOpportunities  Opportunity[]         @relation("OpportunitySalesOrder")
  stockReservations StockReservation[]
  productionPlans   SalesProductionPlan[]

  @@index([customerPoNo])
  @@index([sourceWarehouseId])
  @@index([companyId])
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  ON_HOLD
  CLOSED
  CANCELLED
}

model SalesOrderItem {
  id                String          @id @default(cuid())
  salesOrderId      String
  salesOrder        SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  description       String?
  quantity          Decimal         @db.Decimal(18, 6)
  unitPrice         Decimal         @db.Decimal(18, 6)
  taxRate           Decimal         @default(0) @db.Decimal(9, 4)
  discount          Decimal         @default(0) @db.Decimal(9, 4)
  total             Decimal         @db.Decimal(18, 6)
  deliveredQty      Decimal         @default(0) @db.Decimal(18, 6)
  billedQty         Decimal         @default(0) @db.Decimal(18, 6)
  producedQty       Decimal         @default(0) @db.Decimal(18, 6)
  backorderQty      Decimal         @default(0) @db.Decimal(18, 6)
  supplyMode        SalesSupplyMode @default(MAKE_TO_STOCK)
  uomId             String?
  sourceWarehouseId String?
  createdAt         DateTime        @default(now())

  stockReservations   StockReservation[]
  productionPlanItems SalesProductionPlanItem[]
}

model SalesProductionPlan {
  id           String                    @id @default(cuid())
  companyId    String?
  planNo       String                    @unique
  salesOrderId String
  salesOrder   SalesOrder                @relation(fields: [salesOrderId], references: [id])
  status       String                    @default("DRAFT")
  targetDate   DateTime?
  notes        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  items        SalesProductionPlanItem[]

  @@index([salesOrderId, status])
}

model SalesProductionPlanItem {
  id               String              @id @default(cuid())
  productionPlanId String
  productionPlan   SalesProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  salesOrderItemId String
  salesOrderItem   SalesOrderItem      @relation(fields: [salesOrderItemId], references: [id])
  plannedQty       Decimal             @db.Decimal(18, 6)
  producedQty      Decimal             @default(0) @db.Decimal(18, 6)
  status           String              @default("PLANNED")
}

model SalesPriceVariance {
  id           String   @id @default(cuid())
  companyId    String?
  documentType String
  documentId   String
  lineId       String?
  productId    String
  customerId   String?
  resolvedRate Decimal  @db.Decimal(18, 6)
  appliedRate  Decimal  @db.Decimal(18, 6)
  variance     Decimal  @db.Decimal(18, 6)
  priceSource  String?
  approvedById String?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([companyId, documentType, documentId])
  @@index([productId, createdAt])
}

// ===================== INVOICING =====================
model SalesInvoice {
  id                 String               @id @default(cuid())
  companyId          String?
  invoiceNo          String               @unique
  seriesId           String?
  customerId         String
  customer           Customer             @relation(fields: [customerId], references: [id])
  salesOrderId       String?
  salesOrder         SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  deliveryNoteId     String?
  deliveryNote       DeliveryNote?        @relation(fields: [deliveryNoteId], references: [id])
  amendedFromId      String?
  amendedFrom        SalesInvoice?        @relation("SalesInvoiceAmendments", fields: [amendedFromId], references: [id])
  amendments         SalesInvoice[]       @relation("SalesInvoiceAmendments")
  date               DateTime             @default(now())
  dueDate            DateTime?
  submittedAt        DateTime?
  cancelledAt        DateTime?
  status             DocumentStatus       @default(DRAFT)
  paymentStatus      InvoicePaymentStatus @default(UNPAID)
  taxInclusive       Boolean              @default(false)
  subtotal           Decimal              @default(0) @db.Decimal(18, 6)
  taxAmount          Decimal              @default(0) @db.Decimal(18, 6)
  discount           Decimal              @default(0) @db.Decimal(18, 6)
  roundingAdjustment Decimal              @default(0) @db.Decimal(18, 6)
  total              Decimal              @default(0) @db.Decimal(18, 6)
  grandTotal         Decimal              @default(0) @db.Decimal(18, 6)
  outstandingAmount  Decimal              @default(0) @db.Decimal(18, 6)
  amountPaid         Decimal              @default(0) @db.Decimal(18, 6)
  currency           String               @default("USD")
  notes              String?
  terms              String?
  shippingAddressSnapshot Json?
  createdById        String?
  createdBy          User?                @relation("SalesInvoiceCreatedBy", fields: [createdById], references: [id])
  assignedToId       String?
  assignedTo         User?                @relation("SalesInvoiceAssignedTo", fields: [assignedToId], references: [id])
  tags               String[]             @default([])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  items              SalesInvoiceItem[]
  taxes              SalesInvoiceTax[]
  payments           Payment[]
  paymentAllocations PaymentEntryAllocation[]
  creditNotes        CreditNote[]
  ledgerEntries      GeneralLedgerEntry[]
  auditLogs          AuditLog[]
  subscriptionRuns   SubscriptionInvoiceRun[]
  ewayBills          EwayBill[]

  @@index([customerId, status, paymentStatus])
  @@index([salesOrderId])
  @@index([deliveryNoteId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([companyId])
}

model DeliveryNote {
  id           String         @id @default(cuid())
  companyId    String?
  deliveryNo   String         @unique
  seriesId     String?
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  warehouseId  String?
  warehouse    Warehouse?     @relation(fields: [warehouseId], references: [id])
  date         DateTime       @default(now())
  postingDate  DateTime?
  status       DocumentStatus @default(DRAFT)
  submittedAt  DateTime?
  cancelledAt  DateTime?
  shippingAddressSnapshot Json?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items     DeliveryNoteItem[]
  invoices  SalesInvoice[]
  auditLogs AuditLog[]
  ewayBills EwayBill[]

  @@index([customerId, status])
  @@index([salesOrderId])
  @@index([warehouseId])
  @@index([companyId])
}

model DeliveryNoteItem {
  id             String       @id @default(cuid())
  deliveryNoteId String
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  itemCode       String       @default("")
  description    String?
  quantity       Decimal      @db.Decimal(18, 6)
  deliveredQty   Decimal      @default(0) @db.Decimal(18, 6)
