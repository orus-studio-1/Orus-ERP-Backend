  currency            String         @default("USD")
  exchangeRate        Decimal        @default(1) @db.Decimal(18, 6)
  acceptedQty         Decimal        @default(0) @db.Decimal(18, 6)
  rejectedQty         Decimal        @default(0) @db.Decimal(18, 6)
  subtotal            Decimal        @default(0) @db.Decimal(18, 6)
  landedCostAmount    Decimal        @default(0) @db.Decimal(18, 6)
