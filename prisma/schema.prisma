  sentAt          DateTime?
  respondedAt     DateTime?
  acknowledgedAt  DateTime?
  acknowledgement String?
  portalToken     String?             @unique
  deliveredAt     DateTime?

  @@unique([rfqId, supplierId])
}

enum RfqSupplierStatus {
  PENDING
  SENT
  RESPONDED
  DECLINED
}

