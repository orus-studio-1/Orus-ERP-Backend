  company        Company?           @relation(fields: [companyId], references: [id])
  payrollNo      String
  month          Int
  year           Int
  postingDate    DateTime           @default(now())
  status         PayrollEntryStatus @default(DRAFT)
  totalGross     Decimal            @default(0) @db.Decimal(18, 6)
  totalDeduction Decimal            @default(0) @db.Decimal(18, 6)
