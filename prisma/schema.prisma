  status PaymentEntryStatus @default(DRAFT)
  type SupplierPaymentType @default(INVOICE_PAYMENT)
  date DateTime @default(now())
  amount Decimal @db.Decimal(18, 6)
  allocatedAmount Decimal @default(0) @db.Decimal(18, 6)
  unallocatedAmount Decimal @default(0) @db.Decimal(18, 6)
  currency String @default("USD")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  method PaymentMethod @default(BANK_TRANSFER)
  reference String?
  notes String?
  submittedAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([purchaseInvoiceId])
}

enum SupplierPaymentType {
  ADVANCE
  INVOICE_PAYMENT
}

model SupplierCommunicationLog {
  id String @id @default(cuid())
  companyId String?
  supplierId String?
  rfqId String?
  rfq RequestForQuotation? @relation(fields: [rfqId], references: [id])
  supplierQuotationId String?
  supplierQuotation SupplierQuotation? @relation(fields: [supplierQuotationId], references: [id])
  channel CommunicationChannel @default(EMAIL)
  subject String?
  message String
  direction CommunicationDirection @default(OUTBOUND)
  sentAt DateTime @default(now())
  createdById String?

  @@index([companyId])
  @@index([rfqId])
  @@index([supplierQuotationId])
}

enum CommunicationChannel {
  EMAIL
  PHONE
  PORTAL
  NOTE
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

// ===================== PROJECTS / TEAM WORKSPACE =====================
model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  progress    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks      Task[]
  milestones Milestone[]
  documents  Document[]
  members    ProjectMember[]
  materialRequests MaterialRequest[]
  purchaseOrders PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  purchaseInvoices PurchaseInvoice[]
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  role      String  @default("MEMBER")

  @@unique([projectId, userId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String
  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id])
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  parentId    String?
  parent      Task?      @relation("SubTasks", fields: [parentId], references: [id])
  subtasks    Task[]     @relation("SubTasks")
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  comments Comment[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

model Milestone {
  id          String          @id @default(cuid())
  name        String
  description String?
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

model Document {
  id         String   @id @default(cuid())
  name       String
  type       String?
  url        String
  size       Int?
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  uploadedBy String?
  createdAt  DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}
