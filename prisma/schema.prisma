  defaultAmount Decimal?            @db.Decimal(18, 6)
  formula       String?
  isTaxable     Boolean             @default(false)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())

  structureComponents SalaryStructureComponent[]
