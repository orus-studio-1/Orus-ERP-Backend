  subject             String?
  message             String
  direction           CommunicationDirection @default(OUTBOUND)
  sentAt              DateTime               @default(now())
  createdById         String?

  @@index([companyId])
  @@index([rfqId])
  @@index([supplierQuotationId])
}

enum CommunicationChannel {
  EMAIL
  PHONE
  PORTAL
  NOTE
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

