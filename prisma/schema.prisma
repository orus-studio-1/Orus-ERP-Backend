  deliveryNoteId       String?
  deliveryNote         DeliveryNote?  @relation(fields: [deliveryNoteId], references: [id])
  stockTransferOrderId String?
  purchaseReturnId     String?
  supplyType           String         @default("O")
  subSupplyType        Int            @default(1)
  docType              String         @default("INV")
  docNo                String
  docDate              DateTime
  transactionType      Int            @default(1)
  dispatchGstin        String
  fromGstin            String
  fromName             String?
  fromAddr1            String?
  fromAddr2            String?
  fromPlace            String?
  fromPincode          String?
  fromStateCode        String?
  actualFromStateCode  String?
  toGstin              String
  toName               String?
  toAddr1              String?
  toAddr2              String?
  toPlace              String?
  toPincode            String?
  toStateCode          String?
  actualToStateCode    String?
  taxableValue         Decimal        @default(0) @db.Decimal(18, 6)
  cgstValue            Decimal        @default(0) @db.Decimal(18, 6)
  sgstValue            Decimal        @default(0) @db.Decimal(18, 6)
  igstValue            Decimal        @default(0) @db.Decimal(18, 6)
  cessValue            Decimal        @default(0) @db.Decimal(18, 6)
  otherValue           Decimal        @default(0) @db.Decimal(18, 6)
  totalValue           Decimal        @default(0) @db.Decimal(18, 6)
  transportMode        String         @default("ROAD")
  distanceKm           Int            @default(0)
  transporterId        String?
  transporterName      String?
  transportDocNo       String?
  transportDocDate     DateTime?
  vehicleNo            String?
  vehicleType          String         @default("R")
  payload              Json?
  response             Json?
  errorMessage         String?
  exportedAt           DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  createdById          String?
  // Split shipment: when one invoice is shipped in multiple vehicles, each vehicle gets its own EwayBill
  // record. splitGroupId links the sibling bills together; splitQuantity is the portion this bill covers.
  splitGroupId         String?
  splitQuantity        Decimal?       @db.Decimal(18, 6)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  items  EwayBillItem[]
  events EwayBillEvent[]

  @@index([companyId, status])
  @@index([salesInvoiceId])
  @@index([deliveryNoteId])
  @@index([ewbNo])
}

model EwayBillItem {
  id            String   @id @default(cuid())
  ewayBillId    String
  ewayBill      EwayBill @relation(fields: [ewayBillId], references: [id], onDelete: Cascade)
  productId     String?
  productName   String
  description   String?
  hsnCode       String
  quantity      Decimal  @db.Decimal(18, 6)
  qtyUnit       String
  taxableAmount Decimal  @db.Decimal(18, 6)
  cgstRate      Decimal  @default(0) @db.Decimal(9, 4)
  sgstRate      Decimal  @default(0) @db.Decimal(9, 4)
  igstRate      Decimal  @default(0) @db.Decimal(9, 4)
  cessRate      Decimal  @default(0) @db.Decimal(9, 4)
}

// History of everything that happens to a bill after it is created: export, number recorded, cancel,
// Part B vehicle change and validity extension. Extension and vehicle changes are done on the NIC portal
// in manual mode and recorded here.
model EwayBillEvent {
  id         String   @id @default(cuid())
  companyId  String?
  ewayBillId String
  ewayBill   EwayBill @relation(fields: [ewayBillId], references: [id], onDelete: Cascade)
  type       String
  data       Json?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([ewayBillId, createdAt])
}
