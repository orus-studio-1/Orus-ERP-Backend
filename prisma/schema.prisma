model Bom {
  id              String                 @id @default(uuid(7)) @db.Uuid
  tenantId        String?                @db.Uuid
  companyId       String
  bomNumber       String
  itemId          String
  quantity        Decimal                @db.Decimal(18, 6)
  uomId           String?
  revisionNumber  Int                    @default(1)
  revisionDate    DateTime               @default(now())
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  status          ManufacturingBomStatus @default(DRAFT)
  isDefault       Boolean                @default(false)
  isActive        Boolean                @default(true)
  supersedesId    String?                @db.Uuid
  ecnId           String?
  bomType         ManufacturingBomType   @default(PRODUCTION)
  routingId       String?                @db.Uuid
  projectQty      Decimal?               @db.Decimal(18, 6)
  rawMaterialCost Decimal                @default(0) @db.Decimal(18, 4)
  operatingCost   Decimal                @default(0) @db.Decimal(18, 4)
