// ===================== E-WAY BILL =====================
enum EwayBillStatus {
  DRAFT
  EXPORTED
  GENERATED
  CANCELLED
  EXPIRED
}

// Per-company settings. MANUAL mode means the ERP prepares the NIC bulk-upload JSON
// and the user records the number returned by the portal. API mode is reserved for a later GSP integration.
model EwayBillConfig {
  id                   String   @id @default(cuid())
  companyId            String?  @unique
  mode                 String   @default("MANUAL")
  provider             String?
  valueThreshold       Decimal  @default(50000) @db.Decimal(18, 6)
  defaultTransportMode String   @default("ROAD")
  defaultTransporterId String?
  defaultTransporter   String?
  hardBlockOnDispatch  Boolean  @default(false)
  credentialsEncrypted String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model EwayBill {
  id                   String         @id @default(cuid())
  companyId            String?
  billNo               String         @unique
