  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  salarySlips SalarySlip[]

  @@unique([companyId, payrollNo])
  @@unique([companyId, month, year])
  @@index([companyId])
